    "Z",        ID_EDIT_REDO,        VIRTKEY, CONTROL, SHIFT
    VK_NUMPAD1, ID_VIEW_FRONT,       VIRTKEY
    VK_NUMPAD1, ID_VIEW_BACK,        VIRTKEY, CONTROL
