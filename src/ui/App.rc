    VK_NUMPAD2, ID_VIEW_ORBIT_DOWN,  VIRTKEY
    VK_DECIMAL, ID_CAMERA_FRAME_SEL, VIRTKEY
    "1",        ID_VIEW_FRONT,       VIRTKEY, ALT
    "3",        ID_VIEW_RIGHT,       VIRTKEY, ALT
    "7",        ID_VIEW_TOP,         VIRTKEY, ALT
    "V",        ID_OBJECT_PASTE,     VIRTKEY, CONTROL
    "G",        ID_OBJECT_SNAP,      VIRTKEY, CONTROL
    "G",        ID_OBJECT_SELECT_SAME, VIRTKEY, SHIFT
    "S",        ID_OBJECT_SAVE,      VIRTKEY, CONTROL, SHIFT
    "E",        ID_OBJECT_BLENDER,   VIRTKEY, CONTROL, SHIFT
    "N",        ID_OBJECT_NEW_BLENDER, VIRTKEY, CONTROL, SHIFT
